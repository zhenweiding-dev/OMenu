# Client-side (exposed to browser)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Server-side (for Vercel Python functions)
GEMINI_API_KEY=your-gemini-api-key
# Comma-separated; tried in order, the next one is used when a model fails
GEMINI_MODEL=gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemma-4-26b-a4b-it
# Upper bound for one attempt on one model, in seconds
GEMINI_TIMEOUT_SECONDS=60
# Only for Supabase projects that still sign user tokens with the legacy HS256 secret
SUPABASE_JWT_SECRET=
